# Configurações do Certificado Digital ICP-Brasil e-CNPJ A1 (Fase 2 - DistDFe SEFAZ)
# NUNCA versione seu arquivo .pfx ou sua senha real no Git.
NFE_CERT_PATH=C:/caminho/para/seu_certificado_a1.pfx
NFE_CERT_SENHA=sua_senha_secreta_aqui
# Sem DPAPI (Linux/macOS/Docker) a senha do certificado cadastrado pela interface NAO e gravada em disco:
# defina NFE_CERT_SENHA no ambiente. Pasta de dados/segredos (padrao: %LOCALAPPDATA%\nfe-local, fora do OneDrive):
# NFE_DATA_DIR=C:/Users/voce/AppData/Local/nfe-local

# Ambiente da SEFAZ: "homologacao" (padrão seguro) ou "producao"
NFE_AMBIENTE=homologacao

# Código IBGE da UF autora (ex.: 35 = SP) e CNPJ opcional de consulta (se vazio, usa o CNPJ do certificado A1)
NFE_UF_AUTOR=35
NFE_CNPJ_CONSULTA=

# URL base do ADN Nacional (NFS-e). Opcional: sobrepoe o padrao do ambiente; deve comecar com https://
# Exemplo: https://adn.producaorestrita.nfse.gov.br/contribuintes
NFE_ADN_URL_BASE=

# Tentativas por consulta ao ADN quando a CONEXAO falha (1 a 5; padrao 3, com espera 2s/5s/10s)
NFE_ADN_TENTATIVAS=3

# Caminho opcional para o banco SQLite local de cursores NSU e notas recebidas (sefaz/storage.py)
NFE_DB_PATH=data/nfe_recebidas.db

# Assistente Opcional de Lote com LLM (compatível com OpenAI, Gemini OpenAI-compat, Groq ou Ollama)
# Se LLM_API_KEY estiver vazio, o módulo fica desativado sem afetar o restante do sistema.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_CHAMADAS_HORA=20

# Privacidade do assistente (ambas desligadas por padrao):
# Por padrao so saem agregados contabeis com emitentes anonimizados ("Emitente 01", "Emitente 02"...).
# 1 = envia razao social e CNPJ reais ao provedor.
LLM_ENVIAR_IDENTIFICADORES=0
# 1 = envia tambem uma amostra de ate 30 notas (tipo, numero, valor, validade e alertas).
LLM_ENVIAR_AMOSTRA=0
